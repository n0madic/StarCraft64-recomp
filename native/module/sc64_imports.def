// Host functions the generated game code calls by name (ADR-086). Both sides expand this list:
// the module defines each as a trampoline through the table the host passes to
// sc64_module_init, and the host fills the table with the real functions, so the module
// needs no symbols from the executable and no import library on Windows.
//
//   SC64_GUEST_CALL(name)                   void name(uint8_t* rdram, recomp_context* ctx)
//   SC64_IMPORT_V(name, params, args)       void name params
//   SC64_IMPORT_R(ret, name, params, args)  ret name params
//
// Adding or changing an entry changes the ABI: bump SC64_MODULE_ABI in sc64_module.h.
// libc (for example the assert handler) is resolved by the module itself.
SC64_GUEST_CALL(__osDisableInt_recomp)
SC64_GUEST_CALL(__osEPiRawReadIo_recomp)
SC64_GUEST_CALL(__osEPiRawStartDma_recomp)
SC64_GUEST_CALL(__osEPiRawWriteIo_recomp)
SC64_GUEST_CALL(__osMotorAccess_recomp)
SC64_GUEST_CALL(__osPiRawStartDma_recomp)
SC64_GUEST_CALL(__osRestoreInt_recomp)
SC64_GUEST_CALL(__osSetFpcCsr_recomp)
SC64_GUEST_CALL(__osSpSetPc_recomp)
SC64_GUEST_CALL(osAiGetStatus_recomp)
SC64_GUEST_CALL(osAiSetFrequency_recomp)
SC64_GUEST_CALL(osAiSetNextBuffer_recomp)
SC64_GUEST_CALL(osCartRomInit_recomp)
SC64_GUEST_CALL(osContGetQuery_recomp)
SC64_GUEST_CALL(osContGetReadData_recomp)
SC64_GUEST_CALL(osContInit_recomp)
SC64_GUEST_CALL(osContStartQuery_recomp)
SC64_GUEST_CALL(osContStartReadData_recomp)
SC64_GUEST_CALL(osCreateMesgQueue_recomp)
SC64_GUEST_CALL(osCreatePiManager_recomp)
SC64_GUEST_CALL(osCreateThread_recomp)
SC64_GUEST_CALL(osCreateViManager_recomp)
SC64_GUEST_CALL(osDestroyThread_recomp)
SC64_GUEST_CALL(osEPiReadIo_recomp)
SC64_GUEST_CALL(osEPiStartDma_recomp)
SC64_GUEST_CALL(osEPiWriteIo_recomp)
SC64_GUEST_CALL(osGetCount_recomp)
SC64_GUEST_CALL(osGetMemSize_recomp)
SC64_GUEST_CALL(osGetThreadPri_recomp)
SC64_GUEST_CALL(osGetTime_recomp)
SC64_GUEST_CALL(osInitialize_recomp)
SC64_GUEST_CALL(osInvalDCache_recomp)
SC64_GUEST_CALL(osInvalICache_recomp)
SC64_GUEST_CALL(osJamMesg_recomp)
SC64_GUEST_CALL(osMotorInit_recomp)
SC64_GUEST_CALL(osPiStartDma_recomp)
SC64_GUEST_CALL(osRecvMesg_recomp)
SC64_GUEST_CALL(osSendMesg_recomp)
SC64_GUEST_CALL(osSetEventMesg_recomp)
SC64_GUEST_CALL(osSetIntMask_recomp)
SC64_GUEST_CALL(osSetThreadPri_recomp)
SC64_GUEST_CALL(osSetTimer_recomp)
SC64_GUEST_CALL(osSpTaskLoad_recomp)
SC64_GUEST_CALL(osSpTaskStartGo_recomp)
SC64_GUEST_CALL(osStartThread_recomp)
SC64_GUEST_CALL(osStopThread_recomp)
SC64_GUEST_CALL(osViBlack_recomp)
SC64_GUEST_CALL(osViGetCurrentFramebuffer_recomp)
SC64_GUEST_CALL(osViGetCurrentLine_recomp)
SC64_GUEST_CALL(osViGetNextFramebuffer_recomp)
SC64_GUEST_CALL(osVirtualToPhysical_recomp)
